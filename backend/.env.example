# Supabase PostgreSQL connection used by the running API.
# On Supabase this is usually the transaction pooler (port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct or session-pooler connection used by Prisma migrations.
# Use the same value as DATABASE_URL when you have one reachable Postgres URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Exact frontend origin allowed by CORS. No trailing slash.
FRONTEND_ORIGIN="http://localhost:3000"

PORT=4000

# Server-only. Leave blank until you are ready to enable location videos.
YOUTUBE_API_KEY=""

OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1/archive"
OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1/search"
OPEN_METEO_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
